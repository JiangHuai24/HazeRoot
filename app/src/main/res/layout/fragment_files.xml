<!--
  文件页 · 按 MT 管理器录屏 1:1 复刻
  ──────────────────────────────────────────────
  结构：
    ┌──────────────────────────────────────┐
    │ ☰   /storage/emulated/0/          ⋮  │ 路径栏
    │     文件夹: N  文件: N  储存: A/B     │ 状态行
    ├──────────────┬───────────────────────┤
    │   左窗列表    │      右窗列表          │ 双窗 50:50，6dp 暗沟槽
    ├──────────────┴───────────────────────┤
    │   <    >    +    ⬅    ↑              │ 底部 5 图标工具栏
    └──────────────────────────────────────┘
-->
<LinearLayout android:orientation="vertical" android:background="@color/bg_page" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== 路径栏 44dp：☰ + 路径 + ⋮ ===== -->
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="4.0dip" android:paddingRight="4.0dip" android:layout_width="fill_parent" android:layout_height="44.0dip">

        <!-- ☰ 菜单：展开含「回队列页/多选/设置」的菜单（文件页隐藏了底部导航，这里作唯一出口） -->
        <TextView android:textSize="17.0sp" android:textColor="@color/label" android:gravity="center" android:id="@id/btnFilesBack" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="44.0dip" android:layout_height="44.0dip" android:text="☰" />

        <!-- 当前窗路径（单行，从头部省略，显示末尾目录） -->
        <TextView android:textSize="15.0sp" android:textColor="@color/label" android:ellipsize="start" android:gravity="center_vertical" android:id="@id/pathTop" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_marginLeft="4.0dip" android:singleLine="true" android:layout_weight="1.0" android:includeFontPadding="false" />

        <!-- ⋮ 溢出菜单 -->
        <TextView android:textSize="18.0sp" android:textColor="@color/label" android:gravity="center" android:id="@id/btnOverflow" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="44.0dip" android:layout_height="44.0dip" android:text="⋮" />
    </LinearLayout>

    <!-- ===== 状态行：文件夹: N  文件: N  储存: A/B ===== -->
    <TextView android:textSize="11.0sp" android:textColor="@color/label_tertiary" android:ellipsize="end" android:id="@id/fileStatus" android:paddingLeft="12.0dip" android:paddingRight="12.0dip" android:paddingBottom="6.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:singleLine="true" android:includeFontPadding="false" />

    <!-- ===== 常用路径快捷（保留） ===== -->
    <HorizontalScrollView android:paddingLeft="12.0dip" android:paddingBottom="6.0dip" android:scrollbars="none" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:id="@id/quickRow" android:layout_width="wrap_content" android:layout_height="30.0dip" />
    </HorizontalScrollView>

    <!-- ===== 选择模式提示条 ===== -->
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@id/pickHintBar" android:background="@drawable/bg_pick_hint" android:paddingLeft="12.0dip" android:paddingRight="4.0dip" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="36.0dip" android:layout_marginLeft="12.0dip" android:layout_marginBottom="4.0dip" android:layout_marginRight="12.0dip">
        <TextView android:textSize="13.0sp" android:textColor="@color/accent" android:ellipsize="end" android:id="@id/pickHint" android:layout_width="0.0dip" android:layout_height="wrap_content" android:singleLine="true" android:layout_weight="1.0" />
        <TextView android:textSize="16.0sp" android:textColor="@color/accent" android:gravity="center" android:id="@id/btnPickClose" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="36.0dip" android:layout_height="36.0dip" android:text="×" />
    </LinearLayout>

    <!-- ===== 多选条（顶部，MT 位置） ===== -->
    <HorizontalScrollView android:id="@id/multiBar" android:background="@drawable/bg_pick_hint" android:visibility="gone" android:scrollbars="none" android:layout_width="fill_parent" android:layout_height="38.0dip" android:layout_marginLeft="12.0dip" android:layout_marginBottom="4.0dip" android:layout_marginRight="12.0dip">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="10.0dip" android:layout_width="wrap_content" android:layout_height="fill_parent">
            <TextView android:textSize="13.0sp" android:textStyle="bold" android:textColor="@color/accent" android:gravity="center_vertical" android:id="@id/multiCount" android:paddingRight="10.0dip" android:layout_width="wrap_content" android:layout_height="fill_parent" />
            <TextView android:textSize="13.0sp" android:textColor="@color/accent" android:gravity="center" android:id="@id/mBtnAll" android:background="@drawable/bg_quick_chip" android:paddingLeft="12.0dip" android:paddingRight="12.0dip" android:layout_width="wrap_content" android:layout_height="28.0dip" android:layout_marginRight="6.0dip" android:text="@string/multi_select_all" />
            <TextView android:textSize="13.0sp" android:textColor="@color/accent" android:gravity="center" android:id="@id/mBtnNone" android:background="@drawable/bg_quick_chip" android:paddingLeft="12.0dip" android:paddingRight="12.0dip" android:layout_width="wrap_content" android:layout_height="28.0dip" android:layout_marginRight="6.0dip" android:text="@string/multi_select_none" />
            <TextView android:textSize="13.0sp" android:textColor="@color/label" android:gravity="center" android:id="@id/mBtnCopy" android:background="@drawable/bg_quick_chip" android:paddingLeft="12.0dip" android:paddingRight="12.0dip" android:layout_width="wrap_content" android:layout_height="28.0dip" android:layout_marginRight="6.0dip" android:text="@string/copy" />
            <TextView android:textSize="13.0sp" android:textColor="@color/label" android:gravity="center" android:id="@id/mBtnMove" android:background="@drawable/bg_quick_chip" android:paddingLeft="12.0dip" android:paddingRight="12.0dip" android:layout_width="wrap_content" android:layout_height="28.0dip" android:layout_marginRight="6.0dip" android:text="@string/move" />
            <TextView android:textSize="13.0sp" android:textColor="@color/label" android:gravity="center" android:id="@id/mBtnZip" android:background="@drawable/bg_quick_chip" android:paddingLeft="12.0dip" android:paddingRight="12.0dip" android:layout_width="wrap_content" android:layout_height="28.0dip" android:layout_marginRight="6.0dip" android:text="@string/multi_zip" />
            <TextView android:textSize="13.0sp" android:textColor="@color/error_text" android:gravity="center" android:id="@id/mBtnDel" android:background="@drawable/bg_quick_chip" android:paddingLeft="12.0dip" android:paddingRight="12.0dip" android:layout_width="wrap_content" android:layout_height="28.0dip" android:layout_marginRight="6.0dip" android:text="@string/delete" />
            <TextView android:textSize="16.0sp" android:textColor="@color/accent" android:gravity="center" android:id="@id/mBtnClose" android:layout_width="36.0dip" android:layout_height="fill_parent" android:text="×" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== 双窗区 ===== -->
    <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="0.0dip" android:layout_weight="1.0">
        <LinearLayout android:orientation="vertical" android:id="@id/paneA" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="2.0dip" android:paddingRight="4.0dip" android:layout_width="fill_parent" android:layout_height="30.0dip">
                <TextView android:textSize="15.0sp" android:textColor="@color/label_secondary" android:gravity="center" android:id="@id/btnUpA" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="26.0dip" android:layout_height="26.0dip" android:text="‹" />
                <TextView android:textSize="11.0sp" android:textColor="@color/label_secondary" android:ellipsize="start" android:gravity="center_vertical" android:id="@id/pathA" android:paddingLeft="4.0dip" android:paddingRight="4.0dip" android:layout_width="0.0dip" android:layout_height="match_parent" android:singleLine="true" android:layout_weight="1.0" android:includeFontPadding="false" />
            </LinearLayout>
            <com.hazeroot.scriptrunner.FilesListView android:id="@id/listA" android:layout_width="fill_parent" android:layout_height="0.0dip" android:divider="@null" android:dividerHeight="0.0dip" android:layout_weight="1.0" />
        </LinearLayout>

        <!-- 双窗中缝：6dp 暗沟槽（MT 实测 6.1dp、零描边）——用留白分区，不用线分区 -->
        <View android:background="#00000000" android:layout_width="6.0dip" android:layout_height="fill_parent" />

        <LinearLayout android:orientation="vertical" android:id="@id/paneB" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="2.0dip" android:paddingRight="4.0dip" android:layout_width="fill_parent" android:layout_height="30.0dip">
                <TextView android:textSize="15.0sp" android:textColor="@color/label_secondary" android:gravity="center" android:id="@id/btnUpB" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="26.0dip" android:layout_height="26.0dip" android:text="‹" />
                <TextView android:textSize="11.0sp" android:textColor="@color/label_secondary" android:ellipsize="start" android:gravity="center_vertical" android:id="@id/pathB" android:paddingLeft="4.0dip" android:paddingRight="4.0dip" android:layout_width="0.0dip" android:layout_height="match_parent" android:singleLine="true" android:layout_weight="1.0" android:includeFontPadding="false" />
            </LinearLayout>
            <com.hazeroot.scriptrunner.FilesListView android:id="@id/listB" android:layout_width="fill_parent" android:layout_height="0.0dip" android:divider="@null" android:dividerHeight="0.0dip" android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 底部 5 图标工具栏（MT 风格） ===== -->
    <LinearLayout android:orientation="horizontal" android:background="@color/bg_soft" android:layout_width="fill_parent" android:layout_height="48.0dip">

        <TextView android:textSize="19.0sp" android:textColor="@color/label_secondary" android:gravity="center" android:id="@id/btnNavBack" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0" android:text="‹" />

        <TextView android:textSize="19.0sp" android:textColor="@color/label_tertiary" android:gravity="center" android:id="@id/btnNavForward" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0" android:text="›" />

        <TextView android:textSize="22.0sp" android:textColor="@color/accent" android:gravity="center" android:id="@id/btnNew" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0" android:text="＋" />

        <TextView android:textSize="18.0sp" android:textColor="@color/label_secondary" android:gravity="center" android:id="@id/btnNavUp" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0" android:text="⬅" />

        <TextView android:textSize="18.0sp" android:textColor="@color/label_secondary" android:gravity="center" android:id="@id/btnNavUpload" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0" android:text="↑" />
