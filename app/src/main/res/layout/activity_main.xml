<?xml version="1.0" encoding="utf-8"?>
<!--
  HazeRoot 主壳 · 底部导航按江南工具箱实测复刻

  实测参照（从 32 帧视频逐帧读出）：
    - 悬浮胶囊容器：圆角药丸，左右留边，不贴底
    - 选中态 = 图标外包一个【品牌色实心圆】，图标变白，文字变亮
    - 未选中 = 纯灰图标 + 灰文字，无任何背景
    - 图标在上、文字在下
    - 容器高度 ~52dp
-->
<LinearLayout android:orientation="vertical" android:background="@color/bg_page" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout android:id="@id/navContainer" android:layout_width="fill_parent" android:layout_height="0.0dip" android:layout_weight="1.0" />

    <!-- ===== 悬浮胶囊导航 ===== -->
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@id/bottomNav" android:background="@drawable/bg_nav_island" android:layout_width="fill_parent" android:layout_height="56.0dip" android:layout_marginLeft="16.0dip" android:layout_marginRight="16.0dip" android:layout_marginBottom="14.0dip" android:elevation="6.0dip">

        <!-- 首页 -->
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@id/tabHome" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0">
            <FrameLayout android:id="@id/blobHome" android:layout_width="30.0dip" android:layout_height="30.0dip">
                <ImageView android:layout_gravity="center" android:id="@id/iconHome" android:layout_width="19.0dip" android:layout_height="19.0dip" android:src="@drawable/ic_home_nav" android:contentDescription="@string/tab_home" />
            </FrameLayout>
            <TextView android:textSize="10.0sp" android:id="@id/labelHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_home" />
        </LinearLayout>

        <!-- 队列 -->
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@id/tabQueue" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0">
            <View android:id="@id/pillQueue" android:visibility="gone" android:layout_width="0.0dip" android:layout_height="0.0dip" />
            <FrameLayout android:id="@id/blobQueue" android:layout_width="30.0dip" android:layout_height="30.0dip">
                <ImageView android:layout_gravity="center" android:id="@id/iconQueue" android:layout_width="19.0dip" android:layout_height="19.0dip" android:src="@drawable/ic_nav_queue" android:contentDescription="@string/tab_queue" />
            </FrameLayout>
            <TextView android:textSize="10.0sp" android:id="@id/labelQueue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_queue" />
        </LinearLayout>

        <!-- 终端 -->
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@id/tabTerminal" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0">
            <FrameLayout android:id="@id/blobTerminal" android:layout_width="30.0dip" android:layout_height="30.0dip">
                <ImageView android:layout_gravity="center" android:id="@id/iconTerminal" android:layout_width="19.0dip" android:layout_height="19.0dip" android:src="@drawable/ic_terminal_nav" android:contentDescription="@string/tab_terminal" />
            </FrameLayout>
            <TextView android:textSize="10.0sp" android:id="@id/labelTerminal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_terminal" />
        </LinearLayout>

        <!-- 文件 -->
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@id/tabFiles" android:background="?selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="1.0">
            <View android:id="@id/pillFiles" android:visibility="gone" android:layout_width="0.0dip" android:layout_height="0.0dip" />
            <FrameLayout android:id="@id/blobFiles" android:layout_width="30.0dip" android:layout_height="30.0dip">
                <ImageView android:layout_gravity="center" android:id="@id/iconFiles" android:layout_width="19.0dip" android:layout_height="19.0dip" android:src="@drawable/ic_nav_files" android:contentDescription="@string/tab_files" />
            </FrameLayout>
            <TextView android:textSize="10.0sp" android:id="@id/labelFiles" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_files" />
        </LinearLayout>

        <!-- 隐藏占位：旧代码仍引用 -->
        <LinearLayout android:id="@id/tabPresets" android:visibility="gone" android:layout_width="0.0dip" android:layout_height="0.0dip">
            <View android:id="@id/pillPresets" android:layout_width="0.0dip" android:layout_height="0.0dip" />
            <ImageView android:id="@id/iconPresets" android:layout_width="0.0dip" android:layout_height="0.0dip" />
            <TextView android:id="@id/labelPresets" android:layout_width="0.0dip" android:layout_height="0.0dip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
