            <TextView android:textSize="12.0sp" android:textColor="@color/label_secondary" android:id="@id/rootText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="5.0dip" android:text="@string/root_checking" />
